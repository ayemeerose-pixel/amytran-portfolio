  <ListItems>
    <ListItem Id="c644a3b7-2369-47f6-82aa-caa16fa5c788" Title="Rye Pham - green lighting" Type="Beat">
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="5.00" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="0ebed2d8-757f-4c4e-bcea-810af69fd084">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">Impulsive, struggles in school but has always tried to make his mom proud and go to a good university because she couldn't, low-income growing up in a nail salon. Sweet kid but can be sarcastic/dry and quick to anger. Very much a high school boy. Child of single mother.</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="5.00" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="23ce03e6-3f13-40c8-98aa-d4e93426eb75"/>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="5.00" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="b1893356-5915-46fe-b340-205af84ff805">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">Internally, always been insecure about financial situation and intellect. Stocky, athletic boy. Extremely family oriented.</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="5.00" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="65efd845-9d25-4b51-9217-21f833de83d6"/>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="5.00" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="5b412317-75dc-4e6a-976e-f071c7f119ae">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">Need: save up for him and his mom to have a house, and for her sake, him to go to college</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="5.00" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="5b412317-75dc-4e6a-976e-f071c7f119ae"/>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="5.00" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="5b412317-75dc-4e6a-976e-f071c7f119ae">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">History:</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="5.00" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="5b412317-75dc-4e6a-976e-f071c7f119ae">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- grew up poor </Text>
          <Text AdornmentStyle="-1" Font="Arial" RevisionID="0" Size="12" Style="">asian</Text>
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style=""> </Text>
          <Text AdornmentStyle="-1" Font="Arial" RevisionID="0" Size="12" Style="">american</Text>
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style=""> whole life</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="5.00" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="5b412317-75dc-4e6a-976e-f071c7f119ae">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- slight resentment towards mother for giving up on herself and not letting herself dream bigger or accept love but loves her more than anything, just wants her to grow up and go out</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="5.00" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="5b412317-75dc-4e6a-976e-f071c7f119ae">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- insecure in </Text>
          <Text AdornmentStyle="-1" Font="Arial" RevisionID="0" Size="12" Style="">intellignece</Text>
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style=""> but doesn't realize he's smart business wise and speaking</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="5.00" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="5b412317-75dc-4e6a-976e-f071c7f119ae">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- thinks he's meant for physical labor, always wanted to play football but no time</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="5.00" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="5b412317-75dc-4e6a-976e-f071c7f119ae">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- big stocky boy. Mom is best friend</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="5.00" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="5b412317-75dc-4e6a-976e-f071c7f119ae">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- anger issues . Hates how his dad was never there. and grew up early</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Id="f7dabeaf-84c9-4d34-93c6-0584f261a42a" Title="Act 2" Type="Beat">
      <SubordinateTo Length="60.000" Level="Outline 1" Number="29.250" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="d75a5a6d-3adc-442b-8f50-0780be4407e1">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">Rye striving to complete his and his mom's mission while also trying to fund her treatment, apply to college, and navigate his personal life. Working himself to the bone and willing to do anything to save her. Daniel helps him. Rye has a land-scaping business to help and a supportive love interest. As he gets close, everything goes to shit.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Id="9bc8e9c0-23b8-4f07-9a1a-3a1417372055" Title="Nancy Pham - pink salon aesthetic" Type="Beat">
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="8fb1b8c3-514f-4b38-a82f-c29f1a327e6f">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">Dieu mom. </Text>
          <Text AdornmentStyle="-1" Font="Arial" RevisionID="0" Size="12" Style="">Fiesty</Text>
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">, single mother, selfless but hides the lengths she goes. Complex in her satisfaction with the choices she's made in her life. Fiercely youthful perhaps to a point of immaturity. Got pregnant young with one of the first Vietnamese men she met in the US out of loneliness. Was sent over by her parents to start a better life and feels that she failed. Independent  and fights her feelings for Daniel, love interest who will do anything for her. Prideful, won't accept financial help.Likes to drink to take off edge which occasionally bothers Rye.</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="8fb1b8c3-514f-4b38-a82f-c29f1a327e6f"/>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="8fb1b8c3-514f-4b38-a82f-c29f1a327e6f">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">History:</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="8fb1b8c3-514f-4b38-a82f-c29f1a327e6f">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- left </Text>
          <Text AdornmentStyle="-1" Font="Arial" RevisionID="0" Size="12" Style="">vietnam</Text>
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style=""> at 10 and had to leave her brother behind, she still has a hurt for it and wants to make her time right in the US but feels she's failed</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="8fb1b8c3-514f-4b38-a82f-c29f1a327e6f">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- pregnant at 18 to one of the first </Text>
          <Text AdornmentStyle="-1" Font="Arial" RevisionID="0" Size="12" Style="">vietnamese</Text>
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style=""> men she met, he's absent (powerful flashback sequence in the rain... cowboys and angels?)</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="8fb1b8c3-514f-4b38-a82f-c29f1a327e6f">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- threatened to leave him for adoption in some box in an alleyway to get him to stay. He still left and she went back to get her baby</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="8fb1b8c3-514f-4b38-a82f-c29f1a327e6f">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- struggles to trust men or to believe she's loveable or worthy, jokingly puts a lot of weight in beauty. Doesn't realize how much people truly love her character and humor </Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="e84e1a82-1f19-4d40-b9c9-4954a259fbff"/>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="6e8e889d-8465-46cc-89dc-9d98d693a6fc">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">Gets cancer as plot point 1 from the nail salon fumes.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Id="84a55757-0c04-4f2e-9b17-9c2180362610" Title="Daniel - the brown where they meet in the middle" Type="Beat">
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="6d7102a1-04c1-4e51-8811-f7c121a3424f">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">Love interest and father figure to Rye. Black, a bit younger than Nancy but much more mature. Foil to Nancy. He is soft and gentle and sensitive. Helps Rye with college applications and writing. Emotionally intelligent and soft-spoken. Obvious entanglement with Nancy, but she's hurt and non-committal. Wants to make things serious with her. High school teacher at Rye's school. Glasses.</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="6d7102a1-04c1-4e51-8811-f7c121a3424f"/>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="6d7102a1-04c1-4e51-8811-f7c121a3424f">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">History:</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="6d7102a1-04c1-4e51-8811-f7c121a3424f">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- grew up also without a dad, like Rye, and wants to fulfill that gap</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="6d7102a1-04c1-4e51-8811-f7c121a3424f">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- no </Text>
          <Text AdornmentStyle="-1" Font="Arial" RevisionID="0" Size="12" Style="">sibilings</Text>
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style=""> either, always had a lot of love to give</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="6d7102a1-04c1-4e51-8811-f7c121a3424f">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- divorced his wife because she was a lot like </Text>
          <Text AdornmentStyle="-1" Font="Arial" RevisionID="0" Size="12" Style="">nancy</Text>
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style=""> in outside demeanor but behind closed doors cruel</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="6d7102a1-04c1-4e51-8811-f7c121a3424f">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- was a sheltered kid that loved to read, so teaches English now because he's passionate about it and it got him through a lot</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="6d7102a1-04c1-4e51-8811-f7c121a3424f">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- </Text>
          <Text AdornmentStyle="-1" Font="Arial" RevisionID="0" Size="12" Style="">berkeley</Text>
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style=""> alum</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="6d7102a1-04c1-4e51-8811-f7c121a3424f"/>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="6d7102a1-04c1-4e51-8811-f7c121a3424f">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">Comes over to help out at home and do things for Nancy and Rye like help with essays, but doesn't live there.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Id="c11d8869-c75a-49e1-bc57-8ca5c3236411" Title="Act 1" Type="Beat">
      <SubordinateTo Length="29.250" Level="Outline 1" Number="0.000" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="a52669fd-fce1-434a-8cab-f3a859270068">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">Building context of their lives and routines and the goals Rye has set with indicators that his mom is sick and not doing anything about it</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Id="f3ad3c72-f4cc-40ed-9214-62a55613c9bc" Title="Central Conflict" Type="Beat">
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="33ad2ecf-210a-46c3-968f-0373ad93cb8d">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">1. Rye: save up for a house in a nicer area and help his mom work less by supporting with the ways he knows how. Make her proud and provide for family. She wants him to go to college and get a cushy office job, but he doesn't believe in himself and knows he's not as good at school as she'd hope.</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="e81dfd24-9591-486d-995e-ea8e7bcd1d7e">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">2. Struggle: doesn't succeed academically, argues with his mom frequently, tired and can only do so much with his talents, mom gets cancer and he has to help fund that treatment instead of just focusing on school and side hustles</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="2b39b662-0acc-4121-8cac-cde6ee901e22">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">3. Raise the money he needs while balancing school and his mom's expectations</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="4bf13fac-0f76-4d3d-91d7-7d39d21b737b">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">4. </Text>
          <Text AdornmentStyle="-1" Font="Arial" RevisionID="0" Size="12" Style="">fear</Text>
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style=""> Mom will die and never see the goals they've been working towards</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="33e917e2-ba78-469d-9836-12bc2e50b3ce">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">5. Does a lot of bad things to make shit shake, gets caught, has to make amends and learn to believe in himself. </Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Id="1a524189-b86b-4ebb-8c31-c1619e3422f5" Title="Act 3" Type="Beat">
      <SubordinateTo Length="30.375" Level="Outline 1" Number="89.250" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="4.17" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="962018c1-84d3-44ab-bf8d-48944bfc2174">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">Making amends for everything going to shit. New regimen to keep himself alive. Gets close to goal again. Hope is on horizon. Mom getting better, reveals that Daniel has proposed again and she's finally accepted. </Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="4.17" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="962018c1-84d3-44ab-bf8d-48944bfc2174"/>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="4.17" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="962018c1-84d3-44ab-bf8d-48944bfc2174">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">Call that she's in critical condition. Rye rushes to hospital to hear "didn't make it" but when he's there he sees his mom is in vital state but with a forehead scar. Not from cancer, from car accident. Room over, it's Daniel that's been hit. He doesn't make it, but leaves behind all the money that Rye and Nancy were too proud to accept. Rye leaves the hospital and knocks a fuck ton of equipment over, goes home, and breaks the already broken generator by throwing the home jar at it. He throws the college jar at the laptop Daniel and him worked on. Takes a deep breath, gathers the money and scoops up the shards cutting his hands, and burns them on the stove. </Text>
          <Text AdornmentStyle="-1" Font="Arial" RevisionID="0" Size="12" Style="">sits</Text>
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style=""> on the couch and cries. Fade into Reveal and resume poem, that he's not giving graduation speech at the end, but that he's wearing cap to Daniel's funeral because it's what he would've wanted. At the end, he walks over and sits down beside his mom and rubs her head. His cap says Berkeley.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Id="d326ea2b-bfd6-4972-a9cc-0fe150f08eb1" Title="Plot Point 1" Type="Beat">
      <SubordinateTo Length="2.250" Level="Outline 2" Number="28.250" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="50ce10db-b79b-4576-a901-a259659aa63e">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">Discovers Nancy's cancer and first argument. She didn't tell him or receive treatment</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Id="32c929e7-9082-4358-a332-563a8e341140" Title="Plot Point 2" Type="Beat">
      <SubordinateTo Length="2.250" Level="Outline 2" Number="88.375" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="1e459edb-9955-4438-9e7f-23100bb78e5e">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">System going, money up, everything collapses. Huge argument with his mom again, decides to make a change to how he's operating to make her proud. Nancy's health seems to be doing better and she gets engaged to Daniel, finally accepting his love.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Id="3b6d4439-cccb-48b6-b127-6b0515290ffe" Title="Scenes 1-5" Type="Beat">
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="c37b3e74-2156-4347-aa53-dcf1ff156453">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">1. Intro</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="5d0689ba-f0a0-42fe-a805-ea91c4ed4eff">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">2. Coming back from school to salon everyday to be with his mom. Doesn't like to go home. Establish context and dynamic</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="6a802bd9-5db7-48c7-810b-6cea1af1ec7c">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">3. Landscaping business</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="42882e2a-5ad8-424d-b980-12da6b1c9590">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">4. Daniel enters, late shift. </Text>
          <Text AdornmentStyle="-1" Font="Arial" RevisionID="0" Size="12" Style="">no</Text>
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style=""> people in the salon, she's doing late private hours</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="4a15e40e-7bc6-45eb-bd2e-af4e6fc44588">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">5. Home to shitty apartment more pressure to do school, notices mom coughing and </Text>
          <Text AdornmentStyle="-1" Font="Arial" RevisionID="0" Size="12" Style="">shi</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="4a15e40e-7bc6-45eb-bd2e-af4e6fc44588"/>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="4a15e40e-7bc6-45eb-bd2e-af4e6fc44588">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="Bold">Scenes 6-10</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="a52669fd-fce1-434a-8cab-f3a859270068"/>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="a52669fd-fce1-434a-8cab-f3a859270068">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- rye goes to school and struggles, coach still asking him to try out for football he clearly wants to and has the build but must prioritize</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="a52669fd-fce1-434a-8cab-f3a859270068">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">-drives a rather dingy landscaping truck but rolls with windows down so he's still </Text>
          <Text AdornmentStyle="-1" Font="Arial" RevisionID="0" Size="12" Style="">lowk</Text>
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style=""> cool</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="a52669fd-fce1-434a-8cab-f3a859270068">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- we meet his sweet lil girl who's notably wealthy, she invites him over for dinner</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="a52669fd-fce1-434a-8cab-f3a859270068">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- overall well liked guy, but he sneaks off the Daniel's classroom for lunch where they hang then he forced to work on college essay together. Daniel lets it slip that she's sick</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="a52669fd-fce1-434a-8cab-f3a859270068">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- come home straight to mow the lawns</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="a52669fd-fce1-434a-8cab-f3a859270068">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- starving and mom has cooked stuff for him but she's still in salon</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="a52669fd-fce1-434a-8cab-f3a859270068">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- comes home out of breath and coughing at dinner. They're </Text>
          <Text AdornmentStyle="-1" Font="Arial" RevisionID="0" Size="12" Style="">vibing</Text>
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style=""> and then arguing when he finds some </Text>
          <Text AdornmentStyle="-1" Font="Arial" RevisionID="0" Size="12" Style="">typa</Text>
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style=""> cancer med?</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Id="fbf40514-78b1-4fdc-8c93-871320b4104e" Title="notes on making a character:" Type="Beat">
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="2.22" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="06140e0b-b2db-457f-abd7-db315c5ecb77">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- know them personally, we want audience to say "i know someone like that!"</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="2.22" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="06140e0b-b2db-457f-abd7-db315c5ecb77">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- be able to answer questions about them all. What motivates them? What made them who they are today?</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Id="e575a4cb-f730-4770-9a38-54ad62dea91c" Title="Lily Benitez" Type="Beat">
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="afe07078-ee7a-40e1-8e54-86107281c124">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">Rye's girlfriend that he ends up robbing</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="28594412-9896-43ae-b638-4ffa2d0467df"/>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="e95b9d53-977e-48d4-8caf-01649a894e67">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- spunky, popular, academically inclined</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="07ef76e8-3d92-4c57-a0bc-1990abbc25d4">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- wealthy with lawyer dad</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="07ef76e8-3d92-4c57-a0bc-1990abbc25d4">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- doctor mom</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="2c04f3d8-6963-431b-8bd0-4bcd28a47828">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- can't </Text>
          <Text AdornmentStyle="-1" Font="Arial" RevisionID="0" Size="12" Style="">realte</Text>
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style=""> to rye in a lot of ways having grown up so differently but genuinely kind and compassionate and wishes she could understand</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="c54b47d4-1b9c-4ed1-8e16-77d37f18c0c3">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- wishes he would open up</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="842001ce-2f88-422f-af07-563fb2c5b400">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- loves him dearly and sees him for his actions past his flaws</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.06" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="ea8fa6c5-c619-4ea8-9485-9b2f634bcc62">
          <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">- talkative</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem EndCap="None" EndPoint="9bc8e9c0-23b8-4f07-9a1a-3a1417372055" FrontCap="None" Id="5561b135-c813-4899-8a2c-a889e3277def" StartPoint="c644a3b7-2369-47f6-82aa-caa16fa5c788" Type="PeerLink"/>
  </ListItems>

